<?xml version="1.0" encoding="utf-8"?>
<!--
  Declares our custom, self-invented AID (F0 + "KALISCOPE" in ASCII).
  category="other" because this is not a payment card — Android reserves
  category="payment" for actual EMV payment apps and requires the app be
  set as the user's default payment app to receive those taps.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_description"
    android:requireDeviceUnlock="false">
    <aid-group
        android:description="@string/hce_aid_group_description"
        android:category="other">
        <aid-filter android:name="F04B414C4953434F5045" />
    </aid-group>
</host-apdu-service>
